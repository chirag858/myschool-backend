# Server
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://127.0.0.1:27017/myschool

# JWT — set strong random secrets in production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# CORS — comma-separated origins, or * for all (dev)
CORS_ORIGIN=*

# Cloudflare R2 (S3-compatible object storage) — real file uploads.
# Optional: leave blank to disable; upload endpoints then 500 with a clear message.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SMTP — transactional email (password-reset OTP). Optional: leave blank in
# dev/test (the OTP is returned in the response there). For Gmail, SMTP_PASS
# is a 16-char App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
